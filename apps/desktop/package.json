{
  "name": "@citegeist/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm --filter @citegeist/ui build && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "package": "pnpm run build && sh ../../scripts/package-mac.sh"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.101.0",
    "@agentclientprotocol/codex-acp": "2.5.0",
    "@citegeist/core": "workspace:*",
    "@citegeist/ops": "workspace:*",
    "@citegeist/schema": "workspace:*",
    "@citegeist/server": "workspace:*",
    "@huggingface/transformers": "^4.3.2",
    "@parcel/watcher": "^2.6.0",
    "better-sqlite3": "^13.0.3",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@citegeist/ui": "workspace:*",
    "@orpc/client": "^1.16.1",
    "@playwright/test": "^1.65.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "catalog:",
    "vite": "^8.3.6",
    "vitest": "catalog:"
  }
}
