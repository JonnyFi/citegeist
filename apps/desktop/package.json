{
  "name": "@citegeist/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm --filter @citegeist/ui build && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@citegeist/core": "workspace:*",
    "@citegeist/ops": "workspace:*",
    "@citegeist/schema": "workspace:*",
    "@orpc/server": "^1.16.1",
    "@parcel/watcher": "^2.6.0",
    "better-sqlite3": "^13.0.3",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@citegeist/ui": "workspace:*",
    "@orpc/client": "^1.16.1",
    "@playwright/test": "^1.64.1",
    "@types/ws": "^8.18.1",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "catalog:"
  }
}
