{
  "name": "citegeist",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "package": "pnpm --filter @citegeist/desktop package",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval:retrieval": "pnpm --filter @citegeist/core --silent eval:retrieval",
    "test:convert": "uv run --directory workers/convert pytest",
    "test:research": "uv run --directory workers/research pytest",
    "verify": "biome check . && turbo run typecheck test && uv run --directory workers/convert pytest && uv run --directory workers/research pytest",
    "prepare": "git config core.hooksPath .githooks || true",
    "app:update": "sh scripts/update-app.sh",
    "release": "sh scripts/release.sh",
    "secrets": "sh scripts/secrets.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.20.5",
    "turbo": "^2.5.0"
  }
}
