{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/.venv",
      "!pnpm-lock.yaml",
      "!**/*.md",
      "!.claude",
      "!workers/research/vendor",
      "!workers/research/*.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/reader/src/**/*.{ts,tsx}",
        "!packages/reader/src/hooks/**",
        "!**/*.test.{ts,tsx}",
        "!packages/reader/src/testing/**",
        "!packages/reader/src/PdfView.tsx",
        "!packages/reader/src/ReflowView.tsx",
        "!packages/reader/src/SelectionPopover.tsx",
        "!packages/reader/src/useSelection.ts"
      ],
      "plugins": ["./biome-plugins/no-effects-and-timers.grit"]
    }
  ]
}
